@model BaseballApp.Models.TeamsViewModel

@{
    ViewData["Title"] = "球隊列表";
}

<div class="container mt-4">
    <h1 class="mb-4">🏆 球隊列表</h1>

    @* --- 勝率與勝場變化折線圖 --- *@
    <div class="card mb-4">
        <div class="card-header">
            <h4>全聯盟勝率與勝場變化</h4>
        </div>
        <div class="card-body">
            <div id="teamWinRateLineChart" style="height:400px;"></div>
        </div>
    </div>

    @* --- 全聯盟戰績表格 --- *@
    <div class="card mb-4">
        <div class="card-header">
            <h4>全聯盟戰績表</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="teamStandingTable">
                    <thead>
                        <tr>
                            <th>球隊</th>
                            <th>出賽</th>
                            <th>勝</th>
                            <th>敗</th>
                            <th>和</th>
                            <th>勝率</th>
                        </tr>
                    </thead>
                    <tbody>
                        @* 這裡之後用 Model 或 ViewBag 傳遞的戰績資料渲染 *@
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var teamStat in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="card-title">@teamStat.Team.TeamName</h3>
                        <p class="card-text">
                            <strong>球隊代碼:</strong> @teamStat.Team.TeamId<br>
                            <strong>比賽場次:</strong> @teamStat.Games 場
                        </p>
                        <a href="@Url.Action("TeamDetail", new { teamId = teamStat.Team.TeamId, seasonId = ViewBag.SeasonId })" 
                           class="btn btn-primary">查看詳情</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js"></script>
    <script src="~/js/teamListCharts.js" asp-append-version="true"></script>
    <script>
        // TODO: 後端需傳遞 chartData 物件 (包含日期、各隊勝場/勝率序列)
