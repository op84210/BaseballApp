@model BaseballApp.Models.RankingsViewModel
@{
    ViewData["Title"] = "排行榜";
}

<div class="container mt-4">
    <h1 class="mb-4">🏆 排行榜</h1>

    <!-- 分類選擇 -->
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link @(Model.Category == BaseballApp.Models.RankingCategory.Batting ? "active" : "")" 
               href="@Url.Action(action: "Rankings", new { seasonId = Model.SeasonId, category = "batting" })">
                打者排行榜
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.Category == BaseballApp.Models.RankingCategory.Pitching ? "active" : "")" 
               href="@Url.Action(action: "Rankings", new { seasonId = Model.SeasonId, category = "pitching" })">
                投手排行榜
            </a>
        </li>
    </ul>

    @if (Model.Category == BaseballApp.Models.RankingCategory.Batting)
    {
        <!-- 打者排行榜 -->
        <div class="card">
            <div class="card-header">
                <h4>打者排行榜 (Top 50)</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>排名</th>
                                <th>球員</th>
                                <th>打席</th>
                                <th>打數</th>
                                <th>安打</th>
                                <th>全壘打</th>
                                <th>打點</th>
                                <th>三振</th>
                                <th>保送</th>
                                <th>打擊率</th>
                                <th>上壘率</th>
                                <th>長打率</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (BattingRankingItem player in Model.BattingRankings)
                            {
                                <tr>
                                    <td>@rank</td>
                                    <td>
                                        <a href="@Url.Action(action: "PlayerDetail", new { playerId = player.PlayerId, seasonId = Model.SeasonId })">
                                            @player.PlayerName
                                        </a>
                                    </td>
                                    <td>@player.PA</td>
                                    <td>@player.AB</td>
                                    <td>@player.H</td>
                                    <td>@player.HR</td>
                                    <td>@player.RBI</td>
                                    <td>@player.SO</td>
                                    <td>@player.BB</td>
                                    <td>@player.AVG.ToString(format: "F3")</td>
                                    <td>@player.OBP.ToString(format: "F3")</td>
                                    <td>@player.SLG.ToString(format: "F3")</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- 投手排行榜 -->
        <div class="card">
            <div class="card-header">
                <h4>投手排行榜 (Top 50)</h4>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>排名</th>
                                <th>球員</th>
                                <th>投球局數</th>
                                <th>被安打</th>
                                <th>被全壘打</th>
                                <th>保送</th>
                                <th>三振</th>
                                <th>失分</th>
                                <th>自責分</th>
                                <th>防禦率</th>
                                <th>WHIP</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rank = 1;
                            }
                            @foreach (PitchingRankingItem pitcher in Model.PitchingRankings)
                            {
                                <tr>
                                    <td>@rank</td>
                                    <td>
                                        <a href="@Url.Action(action: "PlayerDetail", new { playerId = pitcher.PlayerId, seasonId = Model.SeasonId })">
                                            @pitcher.PlayerName
                                        </a>
                                    </td>
                                    <td>@pitcher.IP.ToString(format: "F1")</td>
                                    <td>@pitcher.H</td>
                                    <td>@pitcher.HR</td>
                                    <td>@pitcher.BB</td>
                                    <td>@pitcher.SO</td>
                                    <td>@pitcher.R</td>
                                    <td>@pitcher.ER</td>
                                    <td>@pitcher.ERA.ToString(format: "F2")</td>
                                    <td>@pitcher.WHIP.ToString(format: "F2")</td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
