@model BaseballApp.Models.PlayerDetailViewModel
@{
    ViewData["Title"] = "球員詳情";
}

<div class="container mt-4">
    <div class="mb-3">
        <a href="@Url.Action("Players", new { seasonId = Model.SeasonId })" class="btn btn-secondary">← 返回球員列表</a>
    </div>

    <!-- 球員基本資訊 -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="col-md-4">
                <h2>
                    @if (!string.IsNullOrEmpty(@Model.Player.PlayerNumber))
                    {
                        <span class="badge bg-secondary">@Model.Player.PlayerNumber</span>
                    }
                    @Model.Player.PlayerName
                </h2>
                <p class="text-muted">球員編號: @Model.Player.PlayerId</p>
            </div>
            <div class="col-md-8 text-md-end mt-3 mt-md-0">
                <select id="seriesSelect" class="form-select w-auto">
                    @if (Model.SeriesList != null)
                    {
                        @foreach (SelectListItem s in Model.SeriesList)
                        {
                            @if (s.Value == Model.SeasonId)
                            {
                                <option value="@s.Value" selected>@s.Text</option>
                            }
                            else
                            {
                                <option value="@s.Value">@s.Text</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- 統計數據 -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.Games</h3>
                    <p class="card-text text-muted">出賽數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.TotalPAs</h3>
                    <p class="card-text text-muted">總打席數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.AveragePAsPerGame</h3>
                    <p class="card-text text-muted">平均每場打席數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.HomeRuns</h3>
                    <p class="card-text text-muted">全壘打</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.PAsPerHomeRun</h3>
                    <p class="card-text text-muted">平均幾個打席有一支全壘打</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.Hits</h3>
                    <p class="card-text text-muted">安打數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.AverageHitsPerGame</h3>
                    <p class="card-text text-muted">平均每場安打數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.BattingAverage</h3>
                    <p class="card-text text-muted">打擊率</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.SluggingPercentage</h3>
                    <p class="card-text text-muted">長打率</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.OnBasePercentage</h3>
                    <p class="card-text text-muted">上壘率</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.RBIs</h3>
                    <p class="card-text text-muted">打點數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.StrikeOuts</h3>
                    <p class="card-text text-muted">三振數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.Walks</h3>
                    <p class="card-text text-muted">保送數</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 系列賽分析：選單 + 圖表 -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center flex-wrap gap-2">
            <h4 class="mb-0 me-2">系列賽分析</h4>
        </div>
        <div class="card-body">
            <div class="row gy-3">
                <div class="col-md-6">
                    <div id="lineChart" style="height:320px;"></div>
                </div>
                <div class="col-md-6">
                    <div id="radarChart" style="height:320px;"></div>
                </div>
            </div>
            <hr />
        </div>
    </div>

    <!-- 逐場表現 -->
    <div class="card mb-4">
        <div class="card-header">
            <h4>逐場表現</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="battingTable" class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>賽季名稱</th>
                            <th>場次</th>
                            <th>打席</th>
                            <th>安打</th>
                            <th>全壘打</th>
                            <th>打點</th>
                            <th>三振</th>
                            <th>保送</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Model.Stats.GameStats)
                        {
                            <tr>
                                <td>@game.Date.ToString("yyyy/MM/dd")</td>
                                <td>G@(game.Seq)</td>
                                <td>@game.PA</td>
                                <td>@game.H</td>
                                <td>@game.HR</td>
                                <td>@game.RBI</td>
                                <td>@game.SO</td>
                                <td>@game.BB</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 最佳打席 (依WPA排序) -->
    <div class="card">
        <div class="card-header">
            <h4>最佳打席 (依WPA排序)</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>賽季名稱</th>
                            <th>場次</th>
                            <th>局數</th>
                            <th>打席</th>
                            <th>結果</th>
                            <th>WPA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (dynamic pa in Model.Stats.BestPAs)
                        {
                            <tr>
                                <td>@pa.Date.ToString("yyyy/MM/dd")</td>
                                <td>G@(pa.Seq)</td>
                                <td>@pa.Inning</td>
                                <td>@pa.PASeq</td>
                                <td>@pa.PAResult</td>
                                <td>@pa.WPA?.ToString("F3")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@using System.Text.Json

@section Scripts {
    <script src="~/lib/echarts/echarts.min.js"></script>
    <script src="~/js/playerDetail.js" asp-append-version="true"></script>
    <script>
        // 從後端取得比賽數據
        const gameStats = @Html.Raw(JsonSerializer.Serialize(Model.Stats.GameStats));
        const playerId = '@Model.Player.PlayerId';
        const seasonId = '@Model.SeasonId';
        const actionUrl = '@Url.Action("PlayerDetail", "Baseball")';

        // 初始化模組
        PlayerDetailModule.init(gameStats, seasonId);
        PlayerDetailModule.setupSeasonSelector(playerId, actionUrl);
    </script>
}