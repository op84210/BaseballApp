@model BaseballApp.Models.PlayerDetailViewModel
@{
    ViewData["Title"] = "球員詳情";
}

<div class="container mt-4">
    <div class="mb-3">
        <a href="@Url.Action("Players", new { seasonId = Model.SeasonId })" class="btn btn-secondary">← 返回球員列表</a>
    </div>

    <!-- 系列賽分析：選單 + 圖表 -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center">
            <h4 class="mb-0 me-3">系列賽分析</h4>
            <select id="seriesSelect" class="form-select w-auto">
                <option value="">選擇系列賽...</option>
                @if (Model.SeriesList != null)
                {
                    foreach (SelectListItem s in Model.SeriesList)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="card-body">
            <div class="row gy-3">
                <div class="col-md-6">
                    <div id="lineChart" style="height:320px;"></div>
                </div>
                <div class="col-md-6">
                    <div id="radarChart" style="height:320px;"></div>
                </div>
            </div>
            <hr />
            <div id="seriesMetrics" class="mt-3">
                <p class="text-muted">請選擇系列賽以查看指標。</p>
            </div>
        </div>
    </div>

    <!-- 球員基本資訊 -->
    <div class="card mb-4">
        <div class="card-body">
            <h2>
                @if (!string.IsNullOrEmpty(@Model.Player.PlayerNumber))
                {
                    <span class="badge bg-secondary">@Model.Player.PlayerNumber</span>
                }
                @Model.Player.PlayerName
            </h2>
            <p class="text-muted">球員編號: @Model.Player.PlayerId</p>
        </div>
    </div>

    <!-- 統計數據 -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.TotalPAs</h3>
                    <p class="card-text text-muted">總打席數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.HomeRuns</h3>
                    <p class="card-text text-muted">全壘打</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 逐場表現 -->
    <div class="card mb-4">
        <div class="card-header">
            <h4>逐場表現</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>場次</th>
                            <th>打席</th>
                            <th>安打</th>
                            <th>全壘打</th>
                            <th>打點</th>
                            <th>三振</th>
                            <th>保送</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Model.Stats.GameStats)
                        {
                            <tr>
                                <td>@game.Date</td>
                                <td>G@(game.Seq)</td>
                                <td>@game.PA</td>
                                <td>@game.H</td>
                                <td>@game.HR</td>
                                <td>@game.RBI</td>
                                <td>@game.SO</td>
                                <td>@game.BB</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 最佳打席 (依WPA排序) -->
    <div class="card">
        <div class="card-header">
            <h4>最佳打席 (依WPA排序)</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>場次</th>
                            <th>局數</th>
                            <th>打席</th>
                            <th>結果</th>
                            <th>WPA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (dynamic pa in ViewBag.Stats.BestPAs)
                        {
                            <tr>
                                <td>@pa.Date</td>
                                <td>G@(pa.Seq)</td>
                                <td>@pa.Inning</td>
                                <td>@pa.PASeq</td>
                                <td>@pa.PAResult</td>
                                <td>@pa.WPA?.ToString("F3")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@using System.Text.Json
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>
        // 從後端提供的系列賽統計資料：結構示例
        // SeriesStats: [ { SeriesId, SeriesName, Games:[{Date, Seq, PA, H, HR, RBI, SO, BB, OPS}], Summary:{ AVG, OBP, SLG, OPS, HR, RBI, SO, BB } } ]
        const seriesStats = @Html.Raw(ViewBag.SeriesStats != null ? JsonSerializer.Serialize(ViewBag.SeriesStats) : "[]");

        const lineChart = echarts.init(document.getElementById('lineChart'));
        const radarChart = echarts.init(document.getElementById('radarChart'));

        function renderCharts(series) {
                if (!series) { lineChart.clear(); radarChart.clear(); return; }
                const games = series.Games || [];

                // 折線圖：顯示 OPS 趨勢
                lineChart.setOption({
                        title: { text: series.SeriesName + ' OPS 趨勢', left: 'center', textStyle: { fontSize: 14 } },
                        tooltip: { trigger: 'axis' },
                        grid: { left: 50, right: 20, top: 50, bottom: 40 },
                        xAxis: { type: 'category', data: games.map(g => g.Date) },
                        yAxis: { type: 'value', name: 'OPS' },
                        series: [{
                                name: 'OPS', type: 'line', smooth: true,
                                data: games.map(g => g.OPS),
                                areaStyle: { opacity: 0.15 }
                        }]
                });

                // 雷達圖：能力概況
                const s = series.Summary || {};
                const indicators = [
                        { name: 'AVG', max: 1 },
                        { name: 'OBP', max: 1 },
                        { name: 'SLG', max: 2 },
                        { name: 'HR', max: Math.max((s.HR || 0) * 1.3, 1) },
                        { name: 'RBI', max: Math.max((s.RBI || 0) * 1.3, 1) },
                        { name: 'SO(少為佳)', max: Math.max((s.SO || 0) * 1.3, 5) }
                ];
                radarChart.setOption({
                        title: { text: series.SeriesName + ' 能力雷達', left: 'center', textStyle: { fontSize: 14 } },
                        tooltip: {},
                        radar: { indicator: indicators },
                        series: [{
                                type: 'radar',
                                data: [{
                                        value: [
                                                s.AVG || 0,
                                                s.OBP || 0,
                                                s.SLG || 0,
                                                s.HR || 0,
                                                s.RBI || 0,
                                                (s.SO ? (indicators[5].max - s.SO) : 0) // 反轉三振值 越大代表三振越少
                                        ],
                                        name: series.SeriesName
                                }],
                                areaStyle: { opacity: 0.3 }
                        }]
                });
        }

        function renderMetrics(series) {
                const container = document.getElementById('seriesMetrics');
                if (!series) { container.innerHTML = '<p class="text-muted">請選擇系列賽以查看指標。</p>'; return; }
                const s = series.Summary || {};
                container.innerHTML = `
                        <h5 class="mb-3">${series.SeriesName} 指標總覽</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>AVG</th><th>OBP</th><th>SLG</th><th>OPS</th><th>HR</th><th>RBI</th><th>SO</th><th>BB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>${fmt(s.AVG)}</td>
                                        <td>${fmt(s.OBP)}</td>
                                        <td>${fmt(s.SLG)}</td>
                                        <td>${fmt(s.OPS)}</td>
                                        <td>${s.HR ?? 0}</td>
                                        <td>${s.RBI ?? 0}</td>
                                        <td>${s.SO ?? 0}</td>
                                        <td>${s.BB ?? 0}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>`;
        }

        function fmt(v) { return (v || v === 0) ? Number(v).toFixed(3) : '-'; }

        document.getElementById('seriesSelect').addEventListener('change', e => {
                const id = e.target.value;
                const series = seriesStats.find(s => String(s.SeriesId) === id);
                renderCharts(series);
                renderMetrics(series);
        });

        window.addEventListener('resize', () => { lineChart.resize(); radarChart.resize(); });
</script>
