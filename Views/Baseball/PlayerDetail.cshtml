@model BaseballApp.Models.PlayerDetailViewModel
@{
    ViewData["Title"] = "球員詳情";
}

<div class="container mt-4">
    <div class="mb-3">
        <a href="@Url.Action("Players", new { seasonId = Model.SeasonId })" class="btn btn-secondary">← 返回球員列表</a>
    </div>

    <!-- 系列賽分析：選單 + 圖表 -->
    <div class="card mb-4">
        <div class="card-header d-flex align-items-center">
            <h4 class="mb-0 me-3">系列賽分析</h4>
            <select id="seriesSelect" class="form-select w-auto">
                <option value="">選擇系列賽...</option>
                @if (Model.SeriesList != null)
                {
                    foreach (SelectListItem s in Model.SeriesList)
                    {
                        <option value="@s.Value">@s.Text</option>
                    }
                }
            </select>
        </div>
        <div class="card-body">
            <div class="row gy-3">
                <div class="col-md-6">
                    <div id="lineChart" style="height:320px;"></div>
                </div>
                <div class="col-md-6">
                    <div id="radarChart" style="height:320px;"></div>
                </div>
            </div>
            <hr />
            <div id="seriesMetrics" class="mt-3">
                <p class="text-muted">請選擇系列賽以查看指標。</p>
            </div>
        </div>
    </div>

    <!-- 球員基本資訊 -->
    <div class="card mb-4">
        <div class="card-body">
            <h2>
                @if (!string.IsNullOrEmpty(@Model.Player.PlayerNumber))
                {
                    <span class="badge bg-secondary">@Model.Player.PlayerNumber</span>
                }
                @Model.Player.PlayerName
            </h2>
            <p class="text-muted">球員編號: @Model.Player.PlayerId</p>
        </div>
    </div>

    <!-- 統計數據 -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.TotalPAs</h3>
                    <p class="card-text text-muted">總打席數</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h3 class="card-title">@Model.Stats.HomeRuns</h3>
                    <p class="card-text text-muted">全壘打</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 逐場表現 -->
    <div class="card mb-4">
        <div class="card-header">
            <h4>逐場表現</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>場次</th>
                            <th>打席</th>
                            <th>安打</th>
                            <th>全壘打</th>
                            <th>打點</th>
                            <th>三振</th>
                            <th>保送</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Model.Stats.GameStats)
                        {
                            <tr>
                                <td>@game.Date</td>
                                <td>G@(game.Seq)</td>
                                <td>@game.PA</td>
                                <td>@game.H</td>
                                <td>@game.HR</td>
                                <td>@game.RBI</td>
                                <td>@game.SO</td>
                                <td>@game.BB</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 最佳打席 (依WPA排序) -->
    <div class="card">
        <div class="card-header">
            <h4>最佳打席 (依WPA排序)</h4>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日期</th>
                            <th>場次</th>
                            <th>局數</th>
                            <th>打席</th>
                            <th>結果</th>
                            <th>WPA</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (dynamic pa in Model.Stats.BestPAs)
                        {
                            <tr>
                                <td>@pa.Date</td>
                                <td>G@(pa.Seq)</td>
                                <td>@pa.Inning</td>
                                <td>@pa.PASeq</td>
                                <td>@pa.PAResult</td>
                                <td>@pa.WPA?.ToString("F3")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@using System.Text.Json
<script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>
<script>
        // 從 Model.Stats.GameStats 取得比賽數據
        const gameStats = @Html.Raw(JsonSerializer.Serialize(Model.Stats.GameStats));

        const lineChart = echarts.init(document.getElementById('lineChart'));
        const radarChart = echarts.init(document.getElementById('radarChart'));

        function calculateStats(games) {
                if (!games || games.length === 0) return null;
                
                const totalAB = games.reduce((sum, g) => sum + g.AB, 0);
                const totalH = games.reduce((sum, g) => sum + g.H, 0);
                const total1B = games.reduce((sum, g) => sum + g._1B, 0);
                const total2B = games.reduce((sum, g) => sum + g._2B, 0);
                const total3B = games.reduce((sum, g) => sum + g._3B, 0);
                const totalHR = games.reduce((sum, g) => sum + g.HR, 0);
                const totalBB = games.reduce((sum, g) => sum + g.BB, 0);
                const totalHBP = games.reduce((sum, g) => sum + g.HBP, 0);
                const totalSF = games.reduce((sum, g) => sum + g.SF, 0);
                const totalSO = games.reduce((sum, g) => sum + g.SO, 0);
                const totalRBI = games.reduce((sum, g) => sum + g.RBI, 0);

                const AVG = totalAB > 0 ? totalH / totalAB : 0;
                const OBP = (totalAB + totalBB + totalHBP + totalSF) > 0 
                        ? (totalH + totalBB + totalHBP) / (totalAB + totalBB + totalHBP + totalSF) 
                        : 0;
                const totalBases = total1B + (total2B * 2) + (total3B * 3) + (totalHR * 4);
                const SLG = totalAB > 0 ? totalBases / totalAB : 0;
                const OPS = OBP + SLG;

                return { AVG, OBP, SLG, OPS, HR: totalHR, RBI: totalRBI, SO: totalSO, BB: totalBB };
        }

        function renderCharts(seasonId) {
                if (!seasonId) { 
                        lineChart.clear(); 
                        radarChart.clear(); 
                        return; 
                }
                
                // 篩選該賽季的比賽數據
                const filteredGames = gameStats; // 如果需要按 seasonId 篩選，可以在這裡加入邏輯
                
                // 計算每場的 OPS（簡化版：用打擊率作為趨勢）
                const opsData = filteredGames.map(g => {
                        const avg = g.AB > 0 ? g.H / g.AB : 0;
                        const obp = (g.AB + g.BB + g.HBP + g.SF) > 0 
                                ? (g.H + g.BB + g.HBP) / (g.AB + g.BB + g.HBP + g.SF) 
                                : 0;
                        const bases = g._1B + (g._2B * 2) + (g._3B * 3) + (g.HR * 4);
                        const slg = g.AB > 0 ? bases / g.AB : 0;
                        return obp + slg;
                });

                // 折線圖：顯示逐場 OPS 趨勢
                lineChart.setOption({
                        title: { text: 'OPS 趨勢', left: 'center', textStyle: { fontSize: 14 } },
                        tooltip: { trigger: 'axis' },
                        grid: { left: 50, right: 20, top: 50, bottom: 40 },
                        xAxis: { 
                                type: 'category', 
                                data: filteredGames.map(g => new Date(g.Date).toLocaleDateString('zh-TW', { month: 'numeric', day: 'numeric' }))
                        },
                        yAxis: { type: 'value', name: 'OPS' },
                        series: [{
                                name: 'OPS', type: 'line', smooth: true,
                                data: opsData,
                                areaStyle: { opacity: 0.15 }
                        }]
                });

                // 雷達圖：整體能力概況
                const stats = calculateStats(filteredGames);
                const indicators = [
                        { name: 'AVG', max: 1 },
                        { name: 'OBP', max: 1 },
                        { name: 'SLG', max: 2 },
                        { name: 'HR', max: Math.max((stats.HR || 0) * 1.3, 1) },
                        { name: 'RBI', max: Math.max((stats.RBI || 0) * 1.3, 1) },
                        { name: 'SO(少為佳)', max: Math.max((stats.SO || 0) * 1.3, 5) }
                ];
                radarChart.setOption({
                        title: { text: '能力雷達', left: 'center', textStyle: { fontSize: 14 } },
                        tooltip: {},
                        radar: { indicator: indicators },
                        series: [{
                                type: 'radar',
                                data: [{
                                        value: [
                                                stats.AVG || 0,
                                                stats.OBP || 0,
                                                stats.SLG || 0,
                                                stats.HR || 0,
                                                stats.RBI || 0,
                                                (stats.SO ? (indicators[5].max - stats.SO) : 0)
                                        ],
                                        name: '球員數據'
                                }],
                                areaStyle: { opacity: 0.3 }
                        }]
                });
        }

        function renderMetrics(seasonId) {
                const container = document.getElementById('seriesMetrics');
                if (!seasonId) { 
                        container.innerHTML = '<p class="text-muted">請選擇系列賽以查看指標。</p>'; 
                        return; 
                }
                
                const stats = calculateStats(gameStats);
                const fmt = v => (v || v === 0) ? Number(v).toFixed(3) : '-';
                
                container.innerHTML = `
                        <h5 class="mb-3">指標總覽</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>AVG</th><th>OBP</th><th>SLG</th><th>OPS</th><th>HR</th><th>RBI</th><th>SO</th><th>BB</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>${fmt(stats.AVG)}</td>
                                        <td>${fmt(stats.OBP)}</td>
                                        <td>${fmt(stats.SLG)}</td>
                                        <td>${fmt(stats.OPS)}</td>
                                        <td>${stats.HR ?? 0}</td>
                                        <td>${stats.RBI ?? 0}</td>
                                        <td>${stats.SO ?? 0}</td>
                                        <td>${stats.BB ?? 0}</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>`;
        }

        document.getElementById('seriesSelect').addEventListener('change', e => {
                const seasonId = e.target.value;
                renderCharts(seasonId);
                renderMetrics(seasonId);
        });

        window.addEventListener('resize', () => { lineChart.resize(); radarChart.resize(); });
</script>
