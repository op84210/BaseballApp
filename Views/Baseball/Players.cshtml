@model BaseballApp.Models.PlayersViewModel
@using System.Linq
@using System.Collections.Generic

@{
    ViewData["Title"] = "球員列表";
}

<div class="container mt-4">
    <h1 class="mb-4">👥 球員列表</h1>

    <!-- 篩選器 -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">賽季</label>
                    <select name="seasonId" class="form-select" onchange="this.form.submit()">
                        @foreach (SelectListItem option in Model.SeasonOptions)
                        {
                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">球隊</label>
                    <select name="teamId" class="form-select" onchange="this.form.submit()">
                        @foreach (SelectListItem option in Model.TeamOptions)
                        {
                            <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">球員類型</label>
                    <select name="playerType" class="form-select" onchange="this.form.submit()">
                        @foreach (SelectListItem option in Model.PlayerTypeOptions)
                        {
                            <option value="@option.Value" selected="@(option.Value == Model.PlayerType)">@option.Text</option>
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- 球員列表 -->
    <div class="row">
        @if (Model.Players.Count == 0)
        {
            <div class="col-12">
                <div class="alert alert-info">
                    查無相符的球員資料
                </div>
            </div>
        }
        else
        {
            @foreach (Player player in Model.Players)
            {
                <div class="col-md-3 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                @if (!string.IsNullOrEmpty(player.PlayerNumber))
                                {
                                    <span class="badge bg-secondary">@player.PlayerNumber</span>
                                }
                                @player.PlayerName
                            </h5>
                            <a href="@Url.Action("PlayerDetail", new { playerId = player.PlayerId, seasonId = Model.SeasonId })" 
                               class="btn btn-sm btn-primary">查看詳情</a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
