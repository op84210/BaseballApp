@{
    ViewData["Title"] = "球員列表";
}

<div class="container mt-4">
    <h1 class="mb-4">👥 球員列表</h1>

    <!-- 篩選器 -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">球隊</label>
                    <select name="teamId" class="form-select" onchange="this.form.submit()">
                        <option value="">全部球隊</option>
                        @foreach (var team in ViewBag.Teams)
                        {
                            <option value="@team.TeamId" selected="@(team.TeamId == ViewBag.TeamId)">
                                @team.TeamName
                            </option>
                        }
                    </select>
                </div>
                <input type="hidden" name="seasonId" value="@ViewBag.SeasonId" />
            </form>
        </div>
    </div>

    <!-- 球員列表 -->
    <div class="row">
        @foreach (var player in ViewBag.Batters)
        {
            <div class="col-md-3 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">
                            @if (!string.IsNullOrEmpty(player.PlayerNumber))
                            {
                                <span class="badge bg-secondary">@player.PlayerNumber</span>
                            }
                            @player.PlayerName
                        </h5>
                        <a href="@Url.Action("PlayerDetail", new { playerId = player.PlayerId, seasonId = ViewBag.SeasonId })" 
                           class="btn btn-sm btn-primary">查看詳情</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
