{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseType": "SQLite",
  "ConnectionStrings": {
    "SQLite": "Data Source=data/baseball.db",
    "SqlServer": "Server=localhost;Database=Baseball;Trusted_Connection=True;TrustServerCertificate=True;",
    "PostgreSQL": "Host=localhost;Database=baseball;Username=postgres;Password=yourpassword"
  },
  "RankingCache": {
    "UpdateIntervalHours": 24,
    "StaleThresholdHours": 24
  }
}
